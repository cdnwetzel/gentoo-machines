# Packages too large for 46GB tmpfs — build on disk
# These peak at 35-45GB during compile and would OOM or fill tmpfs
www-client/chromium notmpfs.conf
www-client/chromium-bin notmpfs.conf
sys-devel/llvm notmpfs.conf
dev-lang/rust notmpfs.conf
dev-lang/rust-bin notmpfs.conf
sys-devel/gcc notmpfs.conf
www-client/firefox notmpfs.conf
