# /etc/default/grub - OptiPlex 3080 (i3-10105), headless
# After editing: grub-mkconfig -o /boot/grub/grub.cfg

GRUB_DISTRIBUTOR="Gentoo"

GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu

# Kernel command line
# - i915.enable_fbc=1: framebuffer compression (harmless power saving, headless)
# - intel_iommu=on: enable VT-d
# - mitigations left at kernel default (auto) — fleet policy
GRUB_CMDLINE_LINUX="i915.enable_fbc=1 intel_iommu=on"

GRUB_GFXMODE=auto

GRUB_THEME="/boot/grub/themes/gentoo_glass/theme.txt"

GRUB_DISABLE_LINUX_PARTUUID=false
