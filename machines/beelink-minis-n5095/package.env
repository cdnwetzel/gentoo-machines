# /etc/portage/package.env
# Packages that exceed 4GB tmpfs (Beelink MINI S, 8GB RAM) — redirect to disk
# Same set as Surface Pro 6. N5095A is slower so compiles take longer but
# the disk-vs-tmpfs decision is identical: tmpfs too small, go to disk.
www-client/chromium         notmpfs.conf
www-client/firefox          notmpfs.conf
llvm-core/llvm              notmpfs.conf
llvm-core/clang             notmpfs.conf
dev-lang/rust               notmpfs.conf
dev-qt/qtwebengine          notmpfs.conf
sys-devel/gcc               notmpfs.conf
