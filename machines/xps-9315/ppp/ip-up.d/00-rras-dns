#!/bin/sh
# /etc/ppp/ip-up.d/00-rras-dns — publish peer DNS via resolvconf (shipped by dhcpcd/openresolv).
# pppd exports IFNAME, IPPARAM, DNS1, DNS2 to ip-up scripts when usepeerdns is set.
[ "$IPPARAM" = "rras" ] || exit 0
command -v resolvconf >/dev/null 2>&1 || exit 0
for ns in $DNS1 $DNS2; do
    [ -n "$ns" ] && printf 'nameserver %s\n' "$ns"
done | resolvconf -a "$IFNAME"
exit 0
