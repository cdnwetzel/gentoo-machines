# /etc/ppp/pap-secrets — chmod 600, root:root
# Format: client  server  secret  acceptable-local-IPs
#
# Firm VPN (vpn.example.com), user vpnuser, PAP. Duo second factor: if the
# firm's Duo proxy is in append mode the secret is "password,push" (or
# "password,<6-digit-code>"); in auto-push mode it is just the password.
# Confirm which with the firm.
vpnuser * YourPassword *
