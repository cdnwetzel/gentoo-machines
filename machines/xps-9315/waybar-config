// ~/.config/waybar/config — minimal, text-only formats (no icon-font dependency)
// NOT DEPLOYED: the installed session uses swaybar + i3status (sway/config). Kept as an
// optional alternative; it needs gui-apps/waybar, which is not installed.
{
    "layer": "top",
    "position": "top",
    "height": 26,
    "modules-left": ["sway/workspaces", "sway/window"],
    "modules-right": ["cpu", "memory", "battery", "pulseaudio", "network", "clock"],
    "sway/window": { "max-length": 60 },
    "cpu": { "format": "cpu {usage}%", "interval": 5 },
    "memory": { "format": "mem {used:0.1f}/{total:0.1f}G", "interval": 5 },
    "battery": {
        "format": "bat {capacity}%",
        "format-charging": "bat {capacity}% +",
        "format-discharging": "bat {capacity}% -",
        "format-full": "bat full",
        "states": { "warning": 25, "critical": 10 }
    },
    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "vol muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-"
    },
    "network": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-disconnected": "offline",
        "interval": 10
    },
    "clock": { "format": "{:%a %Y-%m-%d %H:%M}" }
}
