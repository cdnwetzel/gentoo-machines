# ~/.config/sway/config — XPS 9315 minimal session
set $mod Mod4
set $term footclient
set $menu wmenu-run

font pango:monospace 10
floating_modifier $mod normal

# Internal panel: 1920x1200 @ 13.4" (~169 DPI).
# Verify output name first: swaymsg -t get_outputs
output eDP-1 resolution 1920x1200 position 0,0
# Optional fractional scale if text is too small (Wayland handles this cleanly):
# output eDP-1 scale 1.25

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

input type:keyboard {
    xkb_layout us
}

# --- Fn-row hotkeys (verify keycodes in P2: libinput debug-events) ---
# Brightness: sys-power/acpilight (::gentoo) drives /sys/class/backlight/intel_backlight.
# Its 90-backlight.rules makes brightness group-writable by video; chris is in video.
bindsym XF86MonBrightnessUp exec xbacklight -inc 5
bindsym XF86MonBrightnessDown exec xbacklight -dec 5
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

# --- basics ---
bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec $menu

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'

# Screenshots (needs gui-apps/grim, gui-apps/slurp, gui-apps/wl-clipboard)
bindsym Print exec grim - | wl-copy
bindsym Shift+Print exec grim -g "$(slurp)" - | wl-copy

# Firefox camera/mic sharing indicator window is useless in a tiling WM
for_window [title = "Firefox - Sharing Indicator"] kill
for_window [title = "Firefox — Sharing Indicator"] kill

# Portals (camera/screen-share) need the session env published to the D-Bus
# activation environment BEFORE any portal starts. Must be near the top of execs.
exec --no-startup-id dbus-update-activation-environment --all

# PipeWire + WirePlumber + pipewire-pulse inside this session's D-Bus (the bus
# dbus-run-session created in ~/.bash_profile). Gentoo's OpenRC launcher; the
# OpenRC user services would sit on a different bus. 'restart' clears strays.
exec gentoo-pipewire-launcher restart

# foot daemon: one process for all terminal windows (RAM budget)
exec foot -s

# Status bar: built-in swaybar fed by i3status (x11-misc/i3status[pulseaudio],
# volume via pipewire-pulse). Defaults come from /etc/i3status.conf; copy it to
# ~/.config/i3status/config to customize. waybar is NOT installed (see configs/waybar).
bar {
    position top
    status_command i3status
}
