# /etc/portage/package.env/00-notmpfs
# Packages that exceed the 24GB tmpfs (XPS 9510, 32GB RAM) — redirect to disk.
#
# sys-devel/llvm was removed from ::gentoo when the package moved to
# llvm-core/llvm. Portage does not warn about a package.env line for an atom
# that no longer exists, it simply never matches — so the stale entry silently
# left LLVM building in tmpfs, which is the exact failure this file prevents.
www-client/chromium         notmpfs.conf
www-client/firefox          notmpfs.conf
llvm-core/llvm              notmpfs.conf
dev-lang/rust               notmpfs.conf
dev-qt/qtwebengine          notmpfs.conf
sys-devel/gcc               notmpfs.conf

# net-misc/freerdp is deliberately NOT here. Its ffmpeg CFLAGS workaround is
# owned by tools/update-system.sh PORTAGE_WORKAROUNDS, which writes it to
# package.env/90-workarounds and removes it once freerdp is upgraded past
# 3.29.0. A hand-copy here would survive that cleanup.
