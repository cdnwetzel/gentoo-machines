# Gentoo package.accept_keywords - Dell Precision T5810

# Track 6.18 LTS kernel (EOL Dec 2027)
=sys-kernel/gentoo-sources-6.18* ~amd64

# Testing packages needed
www-client/google-chrome ~amd64
www-client/chromium-bin ~amd64
